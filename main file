import random
from tkinter import *

selections = {"rock": "scissors", "paper": "rock", "scissors": "paper"}

def button_clicked(player1_picks):
    computer_picks = random.choice(["rock", "paper", "scissors"])

    if player1_picks == computer_picks:
        result.set(f"Draw!\n\nPlayer: {player1_picks}\nComputer: {computer_picks}")
    elif selections[player1_picks] == computer_picks:
        result.set(f"Player Wins!\n\nPlayer: {player1_picks}\nComputer: {computer_picks}")
    else:
        result.set(f"Computer Wins!\n\nComputer: {computer_picks}\nPlayer: {player1_picks}")

# GUI Setup
window = Tk()
window.title("Rock Paper Scissors Game")

Label(window, text="Choose Rock, Paper, or Scissors:").pack()

Button(window, text="Rock", command=lambda: button_clicked("rock")).pack()
Button(window, text="Paper", command=lambda: button_clicked("paper")).pack()
Button(window, text="Scissors", command=lambda: button_clicked("scissors")).pack()

result = StringVar()
Label(window, textvariable=result, pady=10).pack()

window.mainloop()
